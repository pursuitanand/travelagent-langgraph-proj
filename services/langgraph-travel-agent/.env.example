# ---------------------------------------------------------------------------
# langgraph-travel-agent - example configuration
# Copy to .env for local development.  NEVER commit a filled-in .env.
# ---------------------------------------------------------------------------

# HTTP server
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Comma separated list of origins allowed to call /api/chat.
# "*" is accepted for local development only.
CORS_ALLOWED_ORIGINS=*

# ---------------------------------------------------------------------------
# Flight data
#   json     -> reads data/flights.json (default, no external dependency)
#   postgres -> reads from DATABASE_URL (see db/schema.sql)
#   duffel   -> live inventory from https://duffel.com (needs DUFFEL_ACCESS_TOKEN)
# ---------------------------------------------------------------------------
FLIGHT_REPOSITORY=json
FLIGHTS_DATA_FILE=data/flights.json

# Shift the seeded dataset so that day 0 of the dataset == today.
# Keeps the bundled demo data permanently "in the future".
FLIGHTS_ROLL_DATES=true

# Used when FLIGHT_REPOSITORY=postgres. Left empty for the JSON demo.
# DATABASE_URL=postgresql://travel:travel@localhost:5432/travel_agent
DATABASE_URL=
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# ---------------------------------------------------------------------------
# Duffel (https://duffel.com) - only used when FLIGHT_REPOSITORY=duffel.
# Test tokens start duffel_test_, live tokens duffel_live_. Start with a test
# token: it returns simulated inventory from Duffel's test airlines.
# ---------------------------------------------------------------------------
DUFFEL_ACCESS_TOKEN=
DUFFEL_ENDPOINT=https://api.duffel.com
DUFFEL_API_VERSION=v2

# Our abort deadline for one Duffel call. MUST be greater than the supplier
# timeout, or every slow airline search looks like a client-side timeout.
DUFFEL_TIMEOUT_MS=25000

# How long Duffel waits on each airline (Duffel accepts 2000-60000).
DUFFEL_SUPPLIER_TIMEOUT_MS=20000

# 0 = non-stop only. Lower values mean smaller, faster responses.
DUFFEL_MAX_CONNECTIONS=1

# Extra offer requests to spend on adjacent dates when the requested date is
# empty. Each one is a paid, multi-second call; 0 disables the behaviour.
DUFFEL_MAX_FLEXIBILITY_REQUESTS=2

# /health is polled every few seconds, so the API probe behind it is cached.
DUFFEL_HEALTH_CACHE_MS=60000

# ---------------------------------------------------------------------------
# Web search (https://serper.dev) - server side only, never sent to the browser
# Leave empty to run the agent without live web search.
# ---------------------------------------------------------------------------
SERPER_API_KEY=
SERPER_ENDPOINT=https://google.serper.dev/search
SERPER_TIMEOUT_MS=6000
SERPER_MAX_RESULTS=5

# ---------------------------------------------------------------------------
# LLM (https://console.anthropic.com) - server side only.
# Leave empty to fall back to the deterministic template responder.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=8000
ANTHROPIC_EFFORT=low
ANTHROPIC_TIMEOUT_MS=45000
