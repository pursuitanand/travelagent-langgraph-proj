# ---------------------------------------------------------------------------
# chat-assistant - example configuration
# This service holds NO API keys: it only forwards chat messages to the
# backend, which owns every credential.
# ---------------------------------------------------------------------------

PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Where langgraph-travel-agent lives.
#   local:      http://localhost:8080
#   kubernetes: http://langgraph-travel-agent.travel-agent.svc.cluster.local:8080
BACKEND_URL=http://localhost:8080

# How long to wait for the agent before returning 504 to the browser.
BACKEND_TIMEOUT_MS=60000
